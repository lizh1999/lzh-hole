# lzh-hole daemon 配置模板。
# VIP、peer 公钥和 PSK 不得写入本文件；它们只来自 state_dir 中的配对状态。
state_dir = "/var/db/lzh-hole"
control_socket = "/var/run/lzh-hole/control.sock"

# 替换为实际管理员 UID（id -u）。root 始终也被 peer_cred 鉴权允许。
management_uid = 501

# 省略 interface/bind_ip 时保留最多 8 个物理接口/IPv4 sockets（推荐）。
# 优先有公网路由的接口；LAN 开启时无 WAN 路由的接口仍可用。
# 仅需固定接口时填写；不要使用 utun/lo0/gif/stf：
# interface = "en0"
# 多地址物理接口才设置，且必须是该接口真实持有的 IPv4：
# bind_ip = "192.168.1.10"

udp_port = 51000
# 仅接受数值公网 IPv4:port；部署前须确认可用。
stun_seeds = ["116.162.157.195:3478", "111.206.174.3:3478"]
# 允许 576–1200。
mtu = 1200

[ntfy]
base_url = "https://ntfy.sh"
# 不配置 topic。每条关系的 topic 由 daemon 从该关系的 relationship_id 推导
# （lzh-hole-v1-<32 个小写 hex>），无法配错，也无法用来绕限流。
# 一个 host 只有一个 ntfy actor 订阅全部关系，共用同一个「每 host 至少 30 秒」
# 间隔和同一个 24 小时操作预算；关系数量不会提高操作速率。
# 主机名不经过系统解析器：daemon 在绑定到选定物理接口的 UDP socket 上发一个
# 受界的 IN/A 查询。系统解析器返回 Fake-IP（198.18.0.0/15）因此不再影响信令，
# 也不需要为此改系统 DNS/VPN/默认路由。
# 解析器默认是一条链：先问该接口 DHCP 租约 option 6 里的解析器，再问它自己的
# IPv4 默认网关，任一应答即可；网关不提供 DNS 的网络因此也能工作。
# dns_server 会把这条链固定成唯一一台服务器，且不要求与本机同网段，
# 只要该接口有路由可达它。通常不需要配置：
# dns_server = "192.168.31.1:53"
# resolve_ip 是最后手段：把 base_url 的 hostname 钉死到某个公网 IPv4，仍保留
# HTTPS hostname/SNI/证书校验。服务端换 IP 后必须手工更新，正常部署不要用。
# resolve_ip = "159.203.148.75"

[lan]
# 默认 true，旧配置省略本节也开启。仅通告真实绑定 endpoint 的公共元数据。
enabled = true
