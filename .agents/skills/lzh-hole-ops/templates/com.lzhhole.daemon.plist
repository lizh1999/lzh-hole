<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lzhhole.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/lzh-hole</string>
        <string>daemon</string>
        <string>--config</string>
        <string>/etc/lzh-hole/config.toml</string>
        <string>--allow-tun</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/var/db/lzh-hole</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ExitTimeOut</key>
    <integer>20</integer>

    <!-- 077: launchd creates subsequent service files without group/other access. -->
    <key>Umask</key>
    <integer>63</integer>

    <!-- No UserName: the explicitly authorized dedicated utun/route integration runs as root. -->
</dict>
</plist>
